msgid "Confirm"
msgstr "تأیید"

msgid "Close"
msgstr "بستن"

msgid "Cancel"
msgstr "لغو"

msgid "Selected"
msgstr "انتخاب شده"

msgid "Do you want to download the excel file?"
msgstr "آیا می‌خواهید فایل اکسل را دانلود کنید؟"

msgid "Do you want to download the template?"
msgstr "آیا می‌خواهید قالب را دانلود کنید؟"

msgid "No rows are selected from the records."
msgstr "هیچ ردیفی از رکوردها انتخاب نشده است."

msgid "Do you really want to delete all the selected records?"
msgstr "آیا واقعاً می‌خواهید همه رکوردهای انتخاب شده را حذف کنید؟"

msgid "Do you really want to archive all the selected records?"
msgstr "آیا واقعاً می‌خواهید همه رکوردهای انتخاب شده را بایگانی کنید؟"

msgid "Do you really want to unarchive all the selected records?"
msgstr "آیا واقعاً می‌خواهید همه رکوردهای انتخاب شده را از بایگانی خارج کنید؟"

msgid "Select an option"
msgstr "یک گزینه را انتخاب کنید"

msgid "Connection Lost"
msgstr "اتصال قطع شد"

msgid ""
"We can't reach the server right now. Check your internet connection and try "
"again."
msgstr "در این لحظه نمی‌توانیم به سرور دسترسی پیدا کنیم. اتصال اینترنت خود را بررسی کنید و دوباره تلاش کنید."

msgid "Offline"
msgstr "آفلاین"

msgid "Retry"
msgstr "تلاش دوباره"

msgid "Error code:"
msgstr "کد خطا:"

msgid "No unread notifications"
msgstr "اعلان خوانده نشده ای وجود ندارد"

msgid "No notifications"
msgstr "اعلانی وجود ندارد"
