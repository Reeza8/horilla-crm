#: horilla/contrib/activity/__version__.py:9
msgid ""
"Module for tracking and managing activities such as tasks,calls, events, and "
"emails."
msgstr ""
"ماژول برای پیگیری و مدیریت فعالیت‌هایی مانند وظایف، تماس‌ها، رویدادها و "
"ایمیل‌ها."

#: horilla/contrib/activity/__version__.py:14
msgid ""
"Prioritize the Duplicate list action on global and tab activity list views."
msgstr ""

#: horilla/contrib/activity/__version__.py:18
msgid ""
"Fix TaskCreateForm refresh targeting #TaskTab so new tasks appear without a "
"full reload; enable table_auto on activity tab list views so sticky Actions "
"columns are not clipped. Meeting create: harden invite permissions, "
"timezones, and Meet link handling. Clear email suggestions on blur for "
"activity and meeting forms."
msgstr ""

#: horilla/contrib/activity/__version__.py:25
msgid ""
"Registered Activity for export_data. Improved activity tab hover styles and "
"replaced fixed viewport list widths with flex-based layout."
msgstr ""

#: horilla/contrib/activity/__version__.py:30
msgid ""
"Optional Calls integration without a hard dependency: calls_enabled and "
"get_phone_number template tags gate Call Now in the activity tab when the "
"Calls app is installed. CallListView excludes telephony-purpose logs from "
"the manual call history list. Activity create form excludes "
"call_duration_display."
msgstr ""

#: horilla/contrib/activity/__version__.py:37
msgid ""
"Simplified mail visibility so can_send_mail and can_view_mail follow parent-"
"record change and view access. Activity tab Edit/Delete actions and email "
"Send/Cancel/Snooze actions are gated on parent-record change/delete access "
"with subordinate-aware ownership via get_allowed_user_ids()."
msgstr ""

#: horilla/contrib/activity/__version__.py:44
msgid ""
"Constrained activity tab list table height for consistent scrolling. Added "
"cursor-pointer to Pending and Completed Calls sub-tabs."
msgstr ""

#: horilla/contrib/activity/__version__.py:49
msgid ""
"Disabled base owner_filtration on EmailListView. Centralised get_main_url in "
"the list-view mixin and fixed tab-calls typo in status update and activity "
"tab template. Task and activity creates now navigate directly to the correct "
"tab instead of reverting to the first tab after reload; aligned task-create "
"reload trigger with project-wide jQuery convention. Fixed delete and bulk-"
"action views that reverted to the wrong tab."
msgstr ""

#: horilla/contrib/activity/__version__.py:58
msgid ""
"Fixed call duration field ordering and removed redundant validation; history "
"tab now correctly identifies CallLog entries and displays call status. Use "
"load_branding() TITLE as the fallback company name in meeting invitation "
"emails. Allow ActivityView for users with view_own_activity as well as "
"view_activity. Added meeting provider choices (Zoom, Google Meet, Microsoft "
"Teams) on the Activity model."
msgstr ""

#: horilla/contrib/activity/__version__.py:66
#, fuzzy
#| msgid ""
#| "Email-tab permissions corrected to add/view/change/delete own-record "
#| "checks. Removed redundant fields attributes from create-view forms "
#| "superseded by form_class. Adopted the horilla.utils.timezone shim, "
#| "standardized first-party imports, and added class and method docstrings "
#| "for pylint compliance."
msgid ""
"Email-tab permissions corrected to add/view/change/delete own-record checks. "
"Removed redundant fields attributes from create-view forms superseded by "
"form_class. Adopted the utils.timezone shim, standardized first-party "
"imports, and added class and method docstrings for pylint compliance."
msgstr ""
"مجوزهای برگه ایمیل برای بررسی‌های افزودن/مشاهده/تغییر/حذف رکورد خود اصلاح "
"شدند. ویژگی‌های فیلد اضافی از فرم‌های نمایش ایجاد که توسط form_class جایگزین "
"شده بودند حذف شدند. شیم horilla.utils.timezone پذیرفته شد، واردات طرف اول "
"استاندارد شدند و مستندسازی کلاس و متد برای انطباق با pylint اضافه شد."

#: horilla/contrib/activity/__version__.py:73
#, fuzzy
#| msgid ""
#| "Activity forms aligned with HorillaModelForm layout: field_order, "
#| "Meta.fields = \"__all__\", and Meta.exclude; save logic and HTMX behavior "
#| "unchanged."
msgid ""
"Activity forms aligned with ModelForm layout: field_order, Meta.fields = "
"\"__all__\", and Meta.exclude; save logic and HTMX behavior unchanged."
msgstr ""
"فرم‌های فعالیت با چیدمان HorillaModelForm هماهنگ شدند: field_order، "
"Meta.fields = \"__all__\" و Meta.exclude؛ منطق ذخیره و رفتار HTMX بدون تغییر."

#: horilla/contrib/activity/__version__.py:78
msgid ""
"Meeting integration in activities: schedule meetings from activities, send "
"invites and reminders, and display generated Zoom/Teams meeting links on "
"activity records."
msgstr ""
"یکپارچه‌سازی جلسات در فعالیت‌ها: زمان‌بندی جلسات از فعالیت‌ها، ارسال دعوت‌نامه و "
"یادآوری، و نمایش لینک‌های جلسه تولید شده Zoom/Teams در رکوردهای فعالیت."

#: horilla/contrib/activity/__version__.py:83
msgid ""
"Release 1.10: activity ships under contrib with app label activity. "
"AppLauncher, imports, namespaces, registrations, templates, and metadata "
"references updated from the legacy activity package name to the contrib "
"layout."
msgstr ""
"نسخه ۱.۱۰: فعالیت تحت contrib با برچسب برنامه activity ارائه می‌شود. "
"AppLauncher، واردات، فضای نام، ثبت‌نام‌ها، قالب‌ها و ارجاعات فراداده از نام "
"بسته قدیمی activity به چیدمان contrib به‌روزرسانی شدند."

#: horilla/contrib/activity/__version__.py:89
msgid ""
"Reduced redundant history entries, improved Many-to-Many field "
"representation, and added cleaner labels for mail events and activity "
"creation with new template filters for better rendering."
msgstr ""
"ورودی‌های تاریخچه اضافی کاهش یافتند، نمایش فیلدهای Many-to-Many بهبود یافت و "
"برچسب‌های تمیزتر برای رویدادهای ایمیل و ایجاد فعالیت با فیلترهای قالب جدید "
"برای رندر بهتر اضافه شد."

#: horilla/contrib/activity/__version__.py:95
msgid ""
"Improved activity workflow behavior. The Pending tab now shows all "
"incomplete activitiesregardless of status label, and activity type "
"configuration handling was enhanced for improved workflow accuracy."
msgstr ""
"رفتار گردش کار فعالیت بهبود یافت. برگه در انتظار اکنون همه فعالیت‌های ناقص را "
"بدون توجه به برچسب وضعیت نشان می‌دهد و مدیریت پیکربندی نوع فعالیت برای دقت "
"بهتر گردش کار بهبود یافت."

#: horilla/contrib/activity/__version__.py:102
#, fuzzy
#| msgid ""
#| "Migrated from Django AppConfig to Horilla AppLauncher and replaced Django "
#| "utilities withhorilla.utils.decorators, horilla.utils.translation, and "
