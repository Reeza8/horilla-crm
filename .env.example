# PostgreSQL Database Configuration
POSTGRES_DB=horilla_db
POSTGRES_USER=horilla_user
POSTGRES_PASSWORD=horilla_pass

# Django Configuration
DEBUG=1
SECRET_KEY=dev-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Database URL for Django
DATABASE_URL=postgres://horilla_user:horilla_pass@db:5432/horilla_db

# Redis, Channels and Celery
# Redis is not optional: real-time updates go through Django Channels, and the
# background jobs that deliver scheduled mail and create leads from incoming
# mail run on Celery. Without a worker and a beat scheduler, mail-to-lead never
# runs and no leads are created from email.
REDIS_URL=redis://:horilla_pass@redis:6379/0
CELERY_BROKER_URL=redis://:horilla_pass@redis:6379/0
CELERY_RESULT_BACKEND=redis://:horilla_pass@redis:6379/0
