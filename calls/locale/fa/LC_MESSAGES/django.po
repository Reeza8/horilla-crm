#: calls/__version__.py:6 calls/apps.py:14
msgid "Calls Integration"
msgstr ""

#: calls/__version__.py:9
msgid ""
"Telephony integration for click-to-call from CRM records, multi-provider "
"support (Twilio, SignalWire(Beta), Telnyx(Beta), Sinch(Beta), Exotel(Beta), "
"call logging, agent mapping, and company-level access control."
msgstr ""

#: calls/__version__.py:15
msgid "Fix TemplateSyntaxError crashing the calls user-settings page."
msgstr ""

#: calls/__version__.py:18
msgid ""
"Lock down the calls API to company members with granted access.Seed default "
"call reports for the report engine."
msgstr ""

#: calls/__version__.py:23
msgid ""
"Adopted ScriptResponse and HxTriggerResponse for provider and call-log "
"actions. Preserved exception context when Exotel and SignalWire return non-"
"JSON responses."
msgstr ""

#: calls/__version__.py:28
msgid ""
"Initial release: multi-provider telephony (Twilio, SignalWire(Beta), "
"Telnyx(Beta), Sinch(Beta), Exotel(Beta), Mock) with adapter factory; company "
"enable/disable and role/user access control; Click-to-Call modal with HTMX "
"live status, cancel, and recording toggles; CallLog history with Activity "
"Timeline integration; agent mapping; secure credential storage; Settings → "
"Integrations and My Settings UIs; REST API and webhook/WebSocket consumers."
msgstr ""

